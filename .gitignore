# Claude Code local settings (per-machine)
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Node / web (for when app code lands)
node_modules/
dist/
build/
.cache/
.vite/
*.log
.env
.env.local

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Python (for the future data-prep pipeline)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Chess data & engines — large binaries/datasets, don't commit
# (Lichess DB dumps, Stockfish/Maia binaries, Syzygy tablebases, generated item pools)
data/
*.pgn
*.pgn.zst
*.bin
*.nnue
syzygy/
scratch/

# Repertoire generator output and its explorer cache (issue #88).
# Regenerate with scripts/repertoire/crawl.mjs — see that directory's README.
/out/
.explorer-cache/
.masters-cache/

# Downloaded game databases (Lumbra's Gigabase, Caissabase, Lichess dumps…).
# Multi-hundred-MB third-party data: never committed, always re-downloadable,
# and CC BY-NC-SA in Lumbra's case. See scripts/repertoire/README.md.
/db/
*.7z
*.zst
*.si4
*.si5
*.sg4
*.sg5
*.sn4
*.sn5
*.db3

# Maia spike: the weights are fetched via scripts/setup-maia.mjs, not committed
# (but keep the NOTICE tracked for GPL compliance).
public/models/*.onnx
