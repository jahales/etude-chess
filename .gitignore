# Claude Code local settings (per-machine)
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Node / web (for when app code lands)
node_modules/
dist/
build/
.cache/
.vite/
*.log
.env
.env.local

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Python (for the future data-prep pipeline)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Chess data & engines — large binaries/datasets, don't commit
# (Lichess DB dumps, Stockfish/Maia binaries, Syzygy tablebases, generated item pools)
data/
# ...except the ECO name table, which is 388 KB of CC0 facts and is *required*
# to build — without it every variation label silently disappears. The blanket
# rule above swallowed it, `git add -A` said nothing, and CI was the only thing
# that noticed. See scripts/repertoire/data/README.md.
!scripts/repertoire/data/
*.pgn
*.pgn.zst
*.bin
*.nnue
syzygy/
scratch/

# Repertoire generator working output and its explorer cache (issues #88, #92).
# Regenerate with scripts/repertoire/build.mjs — see that directory's README.
/out/
.explorer-cache/
.masters-cache/

# ...but the built repertoire itself IS tracked. It is our own prose plus
# engine-computed facts (ADR 0018 §2-3), it is the artefact the generator exists
# to produce, and an hour of engine time is a poor thing to ask of a reader who
# just wants to import it. Only the global *.pgn rule reaches into that
# directory, so that is the only thing to counter.
!/repertoire/*.pgn
# v2 ships as staged study decks in a subdirectory, and the exception above is
# deliberately one level deep, so it needs its own. Without it `git add -A` says
# nothing and the decks are simply absent from the repo — which is how the ECO
# data disappeared once already.
!/repertoire/v2/*.pgn

# Downloaded game databases (Lumbra's Gigabase, Caissabase, Lichess dumps…).
# Multi-hundred-MB third-party data: never committed, always re-downloadable,
# and CC BY-NC-SA in Lumbra's case. See scripts/repertoire/README.md.
/db/
*.7z
*.zst
*.si4
*.si5
*.sg4
*.sg5
*.sn4
*.sn5
*.db3

# Maia spike: the weights are fetched via scripts/setup-maia.mjs, not committed
# (but keep the NOTICE tracked for GPL compliance).
public/models/*.onnx
